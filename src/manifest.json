{
    "name": "termPage",
    "version": "1.17.0",
    "author": "Sanalzio",
    "permissions": ["tabs", "storage"],
    "description": "My custom like terminal home page.",

    "manifest_version": 3,

    "chrome_url_overrides": {
        "newtab": "index.html"
    },

    "icons": { "32": "./assets/termTab.svg" },

    "content_security_policy": "script-src 'self' 'unsafe-eval'; object-src 'self'"
}
