!DOCTYPE[html]
html[lang="en"]{
head{
    meta[charset="UTF-8"]%
    meta[name="viewport" content="width=device-width, initial-scale=1.0"]%
    title{New Tab}

    ``` favicon ```
    link[rel="shortcut icon" href="./assets/termTab.png" type="image/x-icon"]%

    ``` import unmodifiable css files ```
    link[rel="stylesheet" href="./css/ansi-escape.css"]%
    link[rel="stylesheet" href="./css/style.css"]%

    ``` import modifiable css files ```
    link[rel="stylesheet" href="./themes/default.css"]%
    link[rel="stylesheet" href="./themes/dark.css" id="color_scheme"]%
    ``` link[rel="stylesheet" href="./themes/glass.css"]%
    link[rel="stylesheet" href="./themes/custom-background.css"]% ```
}
body{
    div#main{
        p#std-out{}
        div#form{
            label#prefix[for="std-in"]{span#usr-host.ansi-green-fg{span#user{user}@span#host{host}}:span#cd.ansi-blue-fg{~}&#36;&nbsp;}
            span#std-in-container{
                span#outo-complete{}
                textarea#std-in[autocomplete="off" spellcheck="false" type="text" name="std-in" rows="1"]{}
            }
        }
    }
    script[src="./scripts/ansi_up.js"]{}
    script[src="./scripts/colorama.js"]{}
    script[src="./scripts/index.js"]{}
}
}

